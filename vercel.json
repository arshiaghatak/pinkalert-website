{
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/(demo|research|founder|signup).html", "destination": "/$1", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(demo|research|founder|signup)", "destination": "/$1.html" }
  ]
}
